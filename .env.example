# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker services
DATABASE_URL=postgresql+asyncpg://driftsentry:driftsentry@postgres:5432/driftsentry
REDIS_URL=redis://redis:6379/0

# JSON list parsed by Pydantic Settings
CORS_ORIGINS=["http://localhost:5173"]

# Local-only default. Use a long random secret outside development.
INGESTION_KEY_PEPPER=development-only-change-me

# Optional incident-report providers. Core monitoring works without these.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
